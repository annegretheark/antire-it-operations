# Kopier til .env.local og tilpass ved behov.
# Adressen til backend-API-et (uten avsluttende skråstrek).
VITE_API_URL=http://localhost:5086

# Innlogging. Én tenant: https://login.microsoftonline.com/<tenant-id>
# Flere tenanter (test og prod): https://login.microsoftonline.com/organizations
# Tillatte tenanter styres i backend (Tenants:Allowed i appsettings.json).
VITE_AUTHORITY=https://login.microsoftonline.com/3af5c92b-38f9-48ce-8746-82bb4c113032
